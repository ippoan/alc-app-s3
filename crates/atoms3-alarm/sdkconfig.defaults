# alc-hub-atoms3-alarm — 点呼端末の警告デバイス (issue #135)
#
# 対象は **Atom VoiceS3R** (M5Stack Atom EchoS3R, SKU C126-ECHO /
# ESP32-S3-PICO-1-N8R8 = 8MB Flash + **8MB Octal PSRAM**)。
# crates/atoms3-timecard と同じ本番機で、**音 (ES8311) と Unit NFC を使う**構成:
# ネットワーク (W5500 / Wi-Fi) は積まないので、あちらから Ethernet 由来の
# 設定は落としてある。Unit NFC 由来の設定は下の「Unit NFC」節 (あちらと同値)。

# ホストリンク (キオスクからの heartbeat / STATUS) は Atom ネイティブ USB-C の
# USB Serial/JTAG コンソール経由。**この機の入出力はここだけ**
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_HZ=1000

# ---- hub-drivers 由来 ----
#
# 本機は uplink も printer も使わないが、alc-hub-drivers は 1 クレートなので
# ws_uplink / auth_link / printer / heap もコンパイル対象に入る。
# 使わなくても宣言だけは要る (atoms3-nfc と同じ 2 行)。

# auth_link / printer / ws_uplink の esp_crt_bundle_attach
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# heap.rs の uxTaskGetSystemState (HEAP DUMP のタスク別スタック余裕)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# シリアル OTA (ota.rs、Refs ippoan/alc-app#425): web インストーラの boot.bin は
# espflash 同梱の bootloader で rollback を持たないため、この設定は bootloader
# 自体には効かず、app 側の API (NEW を書く) にだけ効く。確定と戻しは app が行う
# (ota.rs running_app_pending)。atoms3-timecard と同じ行
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- Unit NFC (atoms3-timecard と同値、Refs ippoan/alc-app#387) ----
#
# **Unit NFC を付けていない機体でもこの節は全部要る** — 同じファームを焼くので、
# C++ (M5UnitUnified + nfc_shim) は常にリンクされ、読み取りスレッドも常に立つ。

# M5UnitUnified の vendor コード (pin.cpp 等) が旧 driver/i2c.h のシンボルを
# 参照しており、nfc_shim (新 driver/i2c_master.h) と同一バイナリにリンクされると
# ESP-IDF 起動直後の __attribute__((constructor)) チェックで即 abort する
# ("CONFLICT! driver_ng is not allowed to be used with this old driver"、
#  実機で確認 2026-07-20)。**入れ忘れると警告デバイスが起動直後に落ち続ける。**
# 経緯は crates/atoms3-timecard/sdkconfig.defaults
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# ST25R3916 ドライバの detect() 内部ポーリングはタイトなビジーウェイトで、
# NFC スレッドが載った CPU の IDLE タスクを飢餓させる。IDLE の WDT 監視だけを外す。
# **タスク WDT 自体は生かす** (ウェッジ検出は残す)。
# main の鳴動ループが飢えない理由は main.rs の `MAIN_TASK_PRIO`
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- PSRAM (機種固有) ----
#
# ★★ **MODE は OCT。QUAD ではない。** ルート (CoreS3) の SPIRAM 設定を
#    そのまま持ってくると QUAD になり、この機では PSRAM が初期化できず
#    IGNORE_NOTFOUND により**黙って PSRAM なしで起動**する。
#
#    根拠は M5Stack 公式ファーム (m5stack/uiflow-micropython) のボード定義:
#    `m5stack/boards/M5STACK_Atom_EchoS3R/mpconfigboard.cmake` の
#    SDKCONFIG_DEFAULTS が `boards/sdkconfig.spiram_oct`
#    (= `CONFIG_SPIRAM_MODE_OCT=y`) を読む。同じ M5 の CoreS3 は
#    `sdkconfig.spiram_sx` で OCT を読まない — **両機の差は M5 自身の設定でも
#    OCT/QUAD で分かれている** (詳細は crates/atoms3-timecard/sdkconfig.defaults)。
#
#    **起動ログの `EVT HEAP` で `free_psram` が 0 でないことを必ず確認すること。**
#    ここを間違えても boot は通るので、コンパイルでは絶対に分からない。
#
#    本機で PSRAM が要るのは再生スレッドのスタック (`task::name_next_psram`) 程度で、
#    無くても鳴る (PSRAM 非搭載なら内部RAM へ落ちる、task.rs 参照)。
#    それでも設定を揃えるのは、**同じ本番機の 2 機種で PSRAM の扱いが違うと
#    「どちらの機の実測か」で毎回混乱する**ため
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 4KB 未満の割当 (頻繁アクセスの小物・ドライバ周り) は内蔵 SRAM に残す。
# 値は atoms3-timecard と同値 — 本機は TLS が無いので余裕はあるが、
# 揃えておく方が「あちらで測った内部RAM の数字」がそのまま参考になる
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# DMA / 内蔵必須の割当 (I2S DMA を含む) が枯渇しないよう内蔵側に 64KB 予約
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# PSRAM 初期化失敗時も abort せず PSRAM なしで boot 継続 (fail-safe)。
# **警告デバイスは boot loop より「PSRAM 無しでも鳴る」方が上**。
# 検出は上記 `free_psram` の目視に委ねる
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
