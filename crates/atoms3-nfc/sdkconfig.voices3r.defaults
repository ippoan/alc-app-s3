# alc-hub-atoms3-nfc の **Atom VoiceS3R (ESP32-S3-PICO-1-N8R8)** 用 overlay
# (`ATOMS3_NFC_VOICES3R` build、Refs ippoan/alc-app#353)。既定の sdkconfig.defaults (AtomS3 Lite =
# PSRAM 非搭載・BLE 無し) の**後ろに** `;` 連結で重ねて使う
# (`ESP_IDF_SDKCONFIG_DEFAULTS` は `;` 区切りのリストで、環境変数は
#  Cargo.toml の metadata より優先される — esp-idf-sys 0.37 build/config.rs)。
#
# **値の正本は `crates/atoms3-timecard/sdkconfig.defaults`。** 同じ板の同じ用途
# (PSRAM + NimBLE) なので 3 本目の複製になるが、本番稼働中の timecard / alarm の
# sdkconfig を同時に共有 overlay へ移すのは risk が見合わないため今回は分けた。

# ---- PSRAM (#151) ----
#
# ★★ **MODE は OCT。QUAD ではない。** ルート (CoreS3) の SPIRAM 設定を
#    そのまま持ってくると QUAD になり、この機では PSRAM が初期化できず
#    IGNORE_NOTFOUND により**黙って PSRAM なしで起動**する
#    (CoreS3 では 2026-07-13 に逆向きで踏んでいる — あちらは OCT 指定で
#     "octal_psram: PSRAM chip is not connected, or wrong PSRAM line mode")。
#
#    根拠は M5Stack 公式ファーム (m5stack/uiflow-micropython) のボード定義:
#    `m5stack/boards/M5STACK_Atom_EchoS3R/mpconfigboard.cmake` の
#    SDKCONFIG_DEFAULTS が `boards/sdkconfig.spiram_oct`
#    (= `CONFIG_SPIRAM_MODE_OCT=y` / `CONFIG_SPIRAM_MODE_QUAD=`) を読む。
#    同じ M5 の CoreS3 (`M5STACK_CoreS3`) は `sdkconfig.spiram_sx` で
#    OCT を読まない — **両機の差は M5 自身の設定でも OCT/QUAD で分かれている**。
#
#    **起動ログの `EVT HEAP` で `free_psram` が 0 でないことを必ず確認すること。**
#    ここを間違えても boot は通ってしまうので、コンパイルでは絶対に分からない。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 4KB 未満の割当 (頻繁アクセスの小物・ドライバ周り) は内蔵 SRAM に残す。
# **1024 を使う理由**: ルートの実測で 4096 にすると 4KB 以下の malloc が全部
# 内部 RAM に載り、NFC を有効にした構成で ws_uplink の TLS ゲート
# (内部RAM 60KB) を満たせなくなる。本機は NFC + TLS の同時稼働なので同条件
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# DMA / 内蔵必須の割当 (W5500 の SPI DMA を含む) が枯渇しないよう内蔵側に 64KB 予約
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# PSRAM 初期化失敗時も abort せず PSRAM なしで boot 継続 (fail-safe)。
# **壁付けの打刻端末は boot loop より「PSRAM 無しでも打刻できる」方が上**という
# 判断。代わりに検出は上記 `free_psram` の目視に委ねる
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# ---- BLE (Omron 血圧計 HEM-6231T、#237 / #135) ----
#
# 以下は timecard からの写しなので「打刻端末」「ws_uplink の TLS ゲート」という
# 言い回しが残っている。**本機 (測定台) に打刻の上りは無い**が、BT controller が
# 内部RAM を食う点と「既定 OFF / ON にしたら再起動」は同じなので値は変えない。
#
# **ルート (CoreS3) の sdkconfig.defaults の BT 節と同値**にしてある。値が割れると
# 「CoreS3 では届くのに VoiceS3R では届かない」が起きるので、片方だけ触らないこと。
# #237 の実証は crates/hub-ble/sdkconfig.probe.defaults (同じ値) を使った
# VoiceS3R 実機で取れている。
#
# BT を有効にしても**既定 (`OMRON BP OFF`) では BLE を起こさない** — main.rs は
# `settings.omron_bp()` が真のときだけ `alc_hub_ble::start` を呼ぶ。controller は
# 内部RAM を使うため、打刻だけの端末で常時初期化すると ws_uplink の TLS ゲート
# (内部RAM 60KB) を削る。ON にしたら再起動が要る (`EVT BLE_DISABLED` が出る)。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# NimBLE ホストのヒープを PSRAM に寄せる (BLE_INIT: Malloc failed の根絶)。
# controller は内部RAM のまま — EXTERNAL は host 側の割当のみ
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
# 同時接続は 1 台。ヒープ節約 (WS の TLS と共存)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# ★★ **この 2 行を落とさないこと** (#237 で半日溶かした真因)。
# Omron HEM-6231T は CCCD を書くと、ホスト (この機) に ATT Find By Type Value Request
# (Current Time Service の検索) を送り、その応答が無いと記録 (0x2A35 indication) を送らない
# (Linux の btmon で確認)。NimBLE は GATT サーバが無効だと ATT の要求に何も応答しない
# (host/src/ble_att.c の dispatch と未知要求へのエラー応答が BLE_GATTS の中) ので、
# peripheral role と GATT サーバを有効にする (サービスは登録せず、Attribute Not Found を返す)。
# **無いとペアリングは通るのに血圧値が 1 件も届かない** — コンパイルでは絶対に分からない。
# advertising はしない
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# ボンディング: Omron は暗号化リンクを要求する。Secure Connections + identity 鍵配布
# (#242) でボンドし、NVS に永続化して次回接続で再ペアリング不要にする。
# **起動時にボンドを消さないこと** — probe bin の作法 (毎回消す) を持ち込むと
# 起動のたびに再ペアリングが要る。消すのは `PAIR` を明示的に受けたときだけ
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_MAX_BONDS=8
# notify コールバックが nimble_host タスク上で println!/format!/ロックを行うため、
# 既定 4KB ではスタックオーバーフローする (実機で血圧受信直後にクラッシュを確認)
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
